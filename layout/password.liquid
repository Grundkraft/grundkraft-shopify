<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_background | default: '#111214' }}">
    <title>{{ shop.name }}</title>
    {% if settings.favicon != blank %}<link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">{% endif %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'brand-components.css' | asset_url | stylesheet_tag }}
    {{ 'commerce.css' | asset_url | stylesheet_tag }}
    {{ 'launch.css' | asset_url | stylesheet_tag }}
    <style>
      {% if settings.type_header_font != blank %}{{ settings.type_header_font | font_face: font_display: 'swap' }}{% endif %}
      {% if settings.type_body_font != blank %}{{ settings.type_body_font | font_face: font_display: 'swap' }}{% endif %}
      :root{
        --gk-bg:{{ settings.color_background | default: '#121212' }};
        --gk-surface:{{ settings.color_surface | default: '#1B1B1B' }};
        --gk-text:{{ settings.color_text | default: '#F3EFE7' }};
        --gk-muted:{{ settings.color_muted | default: '#918C86' }};
        --gk-accent:{{ settings.color_accent | default: '#E15313' }};
        --gk-border:{{ settings.color_border | default: '#404040' }};
        --gk-font-heading:{{ settings.type_header_font.family | default: 'Arial' }},{{ settings.type_header_font.fallback_families | default: 'sans-serif' }};
        --gk-font-body:{{ settings.type_body_font.family | default: 'Arial' }},{{ settings.type_body_font.fallback_families | default: 'sans-serif' }};
      }
    </style>
    {{ content_for_header }}
  </head>
  <body class="template-password">
    <main id="MainContent" class="gk-password-shell" role="main">{{ content_for_layout }}</main>
  </body>
</html>
