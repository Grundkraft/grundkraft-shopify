<section id="die-macher" class="gk-section gk-community-section">
  <div class="gk-container">
    <div class="gk-community">
      <div class="gk-community__lead">
        {% if section.settings.eyebrow != blank %}<p class="gk-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
        <h2 class="gk-heading gk-heading--lg">{{ section.settings.heading | escape }}</h2>
        {% if section.settings.text != blank %}<div class="gk-copy gk-community__copy">{{ section.settings.text }}</div>{% endif %}
        <div class="gk-community__signal" aria-hidden="true"><span>G</span><strong>DIE MACHER</strong></div>
      </div>

      <div class="gk-community__grid">
        {% for block in section.blocks %}
          <article class="gk-community__card gk-halftone" {{ block.shopify_attributes }}>
            <span class="gk-community__number">{{ forloop.index | prepend: '0' }}</span>
            <div class="gk-community__icon" aria-hidden="true">
              {% case forloop.index %}
                {% when 1 %}<svg viewBox="0 0 48 48"><path d="M10 35V20h28v15M15 20v-5h18v5M8 35h32M17 28h14"/></svg>
                {% when 2 %}<svg viewBox="0 0 48 48"><path d="M11 35V18l13-7 13 7v17M18 35V24h12v11M8 39h32"/></svg>
                {% else %}<svg viewBox="0 0 48 48"><path d="M9 34c5-9 11-14 17-14 5 0 9 3 13 9M12 18h9l3 5 4-11 4 6h7M8 39h32"/></svg>
              {% endcase %}
            </div>
            <h3>{{ block.settings.heading | escape }}</h3>
            <p>{{ block.settings.text | escape }}</p>
          </article>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Die Macher",
  "tag": "section",
  "class": "section-gk-community",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Kleine Überschrift", "default": "Die Macher" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Kein Lifestyle-Club. Eine Haltung." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Die Macher sind Menschen, die ihren Alltag nicht für eine Kamera inszenieren müssen. Sie arbeiten, kümmern sich, bewegen etwas und wollen Produkte, die genau dazu passen.</p>" }
  ],
  "blocks": [
    {
      "type": "maker_world",
      "name": "Macher-Welt",
      "settings": [
        { "type": "text", "id": "heading", "label": "Titel", "default": "Im Job" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Bau, Pflege, Produktion, Werkstatt, Außendienst und überall dort, wo ein Tag körperlich wird." }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Die Macher",
      "blocks": [
        { "type": "maker_world", "settings": { "heading": "Im Job", "text": "Bau, Pflege, Produktion, Werkstatt, Außendienst und überall dort, wo ein Tag körperlich wird." } },
        { "type": "maker_world", "settings": { "heading": "Im Alltag", "text": "Familie, Haushalt, Wege und Verantwortung hören nach Feierabend nicht einfach auf." } },
        { "type": "maker_world", "settings": { "heading": "Im echten Leben", "text": "Garten, Bewegung, Projekte und alles, was man macht, weil Stillstand nicht der Plan ist." } }
      ]
    }
  ]
}
{% endschema %}
