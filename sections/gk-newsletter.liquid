<section class="gk-section gk-newsletter-section">
  <div class="gk-container">
    <div class="gk-newsletter">
      <div class="gk-newsletter__copy">
        {% if section.settings.eyebrow != blank %}<p class="gk-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
        <h2 class="gk-heading gk-heading--lg">{{ section.settings.heading | escape }}</h2>
        {% if section.settings.text != blank %}<div class="gk-copy">{{ section.settings.text }}</div>{% endif %}
      </div>

      <div class="gk-newsletter__form-wrap">
        {% form 'customer', id: 'GkNewsletterForm', class: 'gk-newsletter__form' %}
          <input type="hidden" name="contact[tags]" value="newsletter,grundkraft">
          <label class="visually-hidden" for="GkNewsletterEmail">E-Mail-Adresse</label>
          <input id="GkNewsletterEmail" type="email" name="contact[email]" value="{% if customer %}{{ customer.email }}{% endif %}" placeholder="DEINE E-MAIL-ADRESSE" autocorrect="off" autocapitalize="off" autocomplete="email" required>
          <button class="gk-btn gk-btn--primary" type="submit">{{ section.settings.button_label | escape }}</button>

          {% if form.posted_successfully? %}
            <p class="gk-newsletter__message" tabindex="-1">Danke. Du bist auf der Liste.</p>
          {% endif %}
          {% if form.errors %}
            <div class="gk-newsletter__message gk-newsletter__message--error">{{ form.errors | default_errors }}</div>
          {% endif %}
        {% endform %}
        <small>{{ section.settings.note | escape }}</small>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "tag": "section",
  "class": "section-gk-newsletter",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Kleine Überschrift", "default": "Werkstatt-Post" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Wenn etwas fertig ist, sagen wir Bescheid." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Produktstarts, neue Varianten und Einblicke in die Entwicklung. Kein tägliches Dauerfeuer.</p>" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Eintragen" },
    { "type": "text", "id": "note", "label": "Hinweis", "default": "Abmeldung jederzeit möglich." }
  ],
  "presets": [
    { "name": "Newsletter" }
  ]
}
{% endschema %}
