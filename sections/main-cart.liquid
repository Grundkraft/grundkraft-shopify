<section class="gk-commerce-hero">
  <div class="gk-container gk-commerce-hero__inner">
    <p class="gk-eyebrow">Warenkorb</p>
    <h1>Dein Werkzeugkasten.</h1>
    <div class="gk-copy"><p>Alles drin, was du für deinen nächsten Schritt ausgewählt hast.</p></div>
  </div>
</section>

<section class="gk-cart">
  <div class="gk-container">
    {% if cart.item_count > 0 %}
      {% form 'cart', cart %}
        <div class="gk-cart__grid">
          <div class="gk-cart-items">
            {% for item in cart.items %}
              {% liquid
                assign cart_placeholder = 'product-tub-tagwerk.svg'
                if item.product.handle contains 'standfest'
                  assign cart_placeholder = 'product-tub-standfest.svg'
                elsif item.product.handle contains 'kraftreserve'
                  assign cart_placeholder = 'product-tub-kraftreserve.svg'
                endif
              %}
              <article class="gk-cart-item">
                <a class="gk-cart-item__media" href="{{ item.url }}">
                  {% if item.image %}
                    {{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: item.product.title }}
                  {% else %}
                    <img src="{{ cart_placeholder | asset_url }}" width="100" height="140" loading="lazy" alt="{{ item.product.title | escape }}">
                  {% endif %}
                </a>
                <div>
                  <a class="gk-cart-item__title" href="{{ item.url }}">{{ item.product.title }}</a>
                  {% unless item.product.has_only_default_variant %}<div class="gk-cart-item__variant">{{ item.variant.title }}</div>{% endunless %}
                  {% if item.selling_plan_allocation %}<div class="gk-cart-item__variant">{{ item.selling_plan_allocation.selling_plan.name }}</div>{% endif %}
                  <a class="gk-cart-remove" href="{{ item.url_to_remove }}">Entfernen</a>
                </div>
                <div class="gk-cart-item__qty">
                  <label class="gk-field-label" for="updates_{{ item.key }}">Anzahl</label>
                  <input id="updates_{{ item.key }}" class="gk-qty" type="number" name="updates[]" value="{{ item.quantity }}" min="0" inputmode="numeric">
                </div>
                <div class="gk-cart-item__price">
                  {% if item.original_line_price > item.final_line_price %}<s>{{ item.original_line_price | money }}</s>{% endif %}
                  <strong>{{ item.final_line_price | money }}</strong>
                </div>
              </article>
            {% endfor %}
          </div>

          <aside class="gk-cart-summary">
            <h2>Zusammenfassung</h2>
            {% if cart.cart_level_discount_applications.size > 0 %}
              {% for discount in cart.cart_level_discount_applications %}
                <div class="gk-cart-summary__line"><span>{{ discount.title }}</span><strong>-{{ discount.total_allocated_amount | money }}</strong></div>
              {% endfor %}
            {% endif %}
            <div class="gk-cart-summary__line gk-cart-summary__total"><span>Gesamt</span><strong>{{ cart.total_price | money }}</strong></div>
            <p class="gk-cart-summary__note">Steuern und Versand werden nach den Einstellungen deines Shopify-Shops berechnet.</p>

            <label class="gk-field-label" for="CartNote">Notiz zur Bestellung</label>
            <textarea id="CartNote" class="gk-cart-note" name="note">{{ cart.note }}</textarea>
            <button class="gk-btn gk-btn--secondary" type="submit" name="update" style="width:100%;margin-bottom:10px">Warenkorb aktualisieren</button>
            <button class="gk-checkout" type="submit" name="checkout">Zur Kasse</button>
            <a class="gk-continue" href="{{ routes.all_products_collection_url }}">Weiter einkaufen</a>

            {% if shop.enabled_payment_types.size > 0 %}
              <div class="gk-payment-icons" aria-label="Akzeptierte Zahlungsarten">
                {% for type in shop.enabled_payment_types %}<span>{{ type | payment_type_svg_tag }}</span>{% endfor %}
              </div>
            {% endif %}
          </aside>
        </div>
      {% endform %}
    {% else %}
      <div class="gk-empty-state">
        <p class="gk-eyebrow">Noch nichts drin</p>
        <h2>Dein Warenkorb ist leer.</h2>
        <p class="gk-copy">Schau in den Werkzeugkasten und wähle das aus, was zu deinem Alltag passt.</p>
        <a class="gk-btn gk-btn--primary" href="{{ routes.all_products_collection_url }}">Produkte ansehen</a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{"name":"GRUNDKRAFT Warenkorb","tag":"section","class":"section-main-cart","settings":[]}
{% endschema %}
