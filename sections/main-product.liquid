{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured_media = current_variant.featured_media | default: product.featured_media
  assign placeholder_asset = 'product-tub-tagwerk.svg'
  if product.handle contains 'standfest'
    assign placeholder_asset = 'product-tub-standfest.svg'
  elsif product.handle contains 'kraftreserve'
    assign placeholder_asset = 'product-tub-kraftreserve.svg'
  endif
%}

<section class="gk-product-page" data-gk-product>
  <div class="gk-container gk-product-page__grid">
    <div class="gk-product-gallery">
      <div class="gk-product-gallery__stage" data-gk-gallery-stage>
        {% if featured_media != blank %}
          <img
            src="{{ featured_media.preview_image | image_url: width: 1400 }}"
            srcset="{{ featured_media.preview_image | image_url: width: 600 }} 600w, {{ featured_media.preview_image | image_url: width: 900 }} 900w, {{ featured_media.preview_image | image_url: width: 1200 }} 1200w, {{ featured_media.preview_image | image_url: width: 1400 }} 1400w"
            sizes="(min-width: 900px) 52vw, 100vw"
            width="{{ featured_media.preview_image.width }}"
            height="{{ featured_media.preview_image.height }}"
            loading="eager"
            fetchpriority="high"
            alt="{{ featured_media.alt | default: product.title | escape }}"
            data-gk-main-media
            data-media-id="{{ featured_media.id }}"
          >
        {% else %}
          <img class="gk-product-gallery__placeholder" src="{{ placeholder_asset | asset_url }}" width="360" height="504" loading="eager" alt="{{ product.title | escape }}" data-gk-main-media>
        {% endif %}
      </div>

      {% if product.media.size > 1 %}
        <div class="gk-product-gallery__thumbs" aria-label="Produktbilder">
          {% for media in product.media %}
            <button
              class="gk-product-thumb{% if media.id == featured_media.id %} is-active{% endif %}"
              type="button"
              data-gk-thumb
              data-media-id="{{ media.id }}"
              data-media-src="{{ media.preview_image | image_url: width: 1400 }}"
              data-media-srcset="{{ media.preview_image | image_url: width: 600 }} 600w, {{ media.preview_image | image_url: width: 900 }} 900w, {{ media.preview_image | image_url: width: 1400 }} 1400w"
              data-media-alt="{{ media.alt | default: product.title | escape }}"
              aria-label="Bild {{ forloop.index }} anzeigen"
            >
              {{ media.preview_image | image_url: width: 180 | image_tag: loading: 'lazy', alt: '' }}
            </button>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <div class="gk-product-info">
      <p class="gk-product-info__eyebrow">GRUNDKRAFT Werkzeugkasten</p>
      <h1>{{ product.title }}</h1>
      {% if product.vendor != blank %}<p class="gk-product-info__vendor">{{ product.vendor }}</p>{% endif %}

      <div class="gk-product-price">
        <span data-gk-product-price>{{ current_variant.price | money }}</span>
        <s data-gk-compare-price {% unless current_variant.compare_at_price > current_variant.price %}hidden{% endunless %}>{% if current_variant.compare_at_price > current_variant.price %}{{ current_variant.compare_at_price | money }}{% endif %}</s>
      </div>
      <div class="gk-product-tax">Preis inkl. Steuern, sofern anwendbar. Versand wird an der Kasse berechnet.</div>
      <div class="gk-product-state">
        <span data-gk-availability>{% if current_variant.available %}Verfügbar{% else %}Aktuell nicht verfügbar{% endif %}</span>
        {% if current_variant.sku != blank %}<span data-gk-sku>Art.-Nr. {{ current_variant.sku }}</span>{% endif %}
      </div>

      {% if product.description != blank %}
        <div class="gk-product-description rte">{{ product.description }}</div>
      {% else %}
        <div class="gk-product-description"><p>Die verbindlichen Produktdetails, Anwendungshinweise und die finale Kennzeichnung werden hier angezeigt, sobald sie für dieses Produkt feststehen.</p></div>
      {% endif %}

      {% form 'product', product, class: 'gk-product-form', id: 'GkProductForm' %}
        {% if form.errors %}<div class="gk-form-error" role="alert">{{ form.errors | default_errors }}</div>{% endif %}

        {% unless product.has_only_default_variant %}
          <div>
            <label class="gk-field-label" for="GkVariantSelect">Variante</label>
            <select id="GkVariantSelect" class="gk-select" name="id" data-gk-variant-select>
              {% for variant in product.variants %}
                <option value="{{ variant.id }}" {% if variant == current_variant %}selected{% endif %}>
                  {{ variant.title }}{% unless variant.available %} · Nicht verfügbar{% endunless %}
                </option>
              {% endfor %}
            </select>
          </div>
        {% else %}
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-gk-variant-select>
        {% endunless %}

        <div class="gk-product-form__row">
          <div>
            <label class="gk-field-label" for="GkQuantity">Anzahl</label>
            <input id="GkQuantity" class="gk-qty" type="number" name="quantity" min="1" value="1" inputmode="numeric">
          </div>
        </div>

        <button class="gk-add" type="submit" name="add" data-gk-add {% unless current_variant.available %}disabled{% endunless %}>
          {% if current_variant.available %}In den Warenkorb{% else %}Nicht verfügbar{% endif %}
        </button>

        {% if section.settings.show_dynamic_checkout and current_variant.available %}
          <div class="gk-dynamic-checkout">{{ form | payment_button }}</div>
        {% endif %}
      {% endform %}

      <div class="gk-product-assurance">
        <div><strong>Klare Funktion</strong><span>Jedes Produkt bekommt einen nachvollziehbaren Platz im System.</span></div>
        <div><strong>Transparente Angaben</strong><span>Finale Mengen und Hinweise stehen direkt am fertigen Produkt.</span></div>
        <div><strong>Für echte Routinen</strong><span>Für Alltag und Arbeit gedacht, nicht als Fitness-Inszenierung.</span></div>
      </div>

      <div class="gk-product-accordions">
        <details open>
          <summary>Produkt & Anwendung</summary>
          <div class="gk-copy"><p>Nutze die Angaben auf dieser Produktseite und der finalen Verpackung. Wo Details noch nicht verbindlich sind, werden sie nicht als fertige Produkteigenschaft dargestellt.</p></div>
        </details>
        <details>
          <summary>Versand & Verfügbarkeit</summary>
          <div class="gk-copy"><p>Verfügbarkeit und Versandinformationen werden anhand der final eingerichteten Produkte, Märkte und Versandprofile angezeigt.</p></div>
        </details>
        {% if product.metafields.custom.ingredients != blank %}
          <details>
            <summary>Inhaltsstoffe</summary>
            <div class="gk-copy">{{ product.metafields.custom.ingredients | metafield_tag }}</div>
          </details>
        {% endif %}
      </div>
    </div>
  </div>

  <script type="application/json" data-gk-variants>{{ product.variants | json }}</script>
  <script type="application/json" data-gk-money-format>{{ shop.money_format | json }}</script>
</section>

{% schema %}
{
  "name": "GRUNDKRAFT Produktseite",
  "tag": "section",
  "class": "section-main-product",
  "settings": [
    { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Dynamischen Checkout-Button anzeigen", "default": true }
  ]
}
{% endschema %}
