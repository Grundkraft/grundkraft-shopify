<section class="gk-commerce-hero">
  <div class="gk-container gk-commerce-hero__inner">
    <p class="gk-eyebrow">Wissen</p>
    <h1>{{ blog.title }}</h1>
    <div class="gk-copy"><p>Klare Erklärungen zu Produkten, Routinen und dem Gedanken hinter GRUNDKRAFT.</p></div>
  </div>
</section>

<section class="gk-collection">
  <div class="gk-container">
    {% paginate blog.articles by 12 %}
      {% if blog.articles_count > 0 %}
        <div class="gk-product-grid">
          {% for article in blog.articles %}
            <article class="gk-product-card">
              <a href="{{ article.url }}">
                <div class="gk-product-card__media">
                  {% if article.image %}
                    {{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: article.title }}
                  {% else %}
                    <img src="{{ 'gk-metal-g.svg' | asset_url }}" width="300" height="300" loading="lazy" alt="">
                  {% endif %}
                </div>
                <div class="gk-product-card__body">
                  <p class="gk-eyebrow">{{ article.published_at | date: '%d.%m.%Y' }}</p>
                  <h2 class="gk-product-card__title">{{ article.title }}</h2>
                  <div class="gk-product-card__meta">{{ article.excerpt_or_content | strip_html | truncate: 150 }}</div>
                </div>
              </a>
            </article>
          {% endfor %}
        </div>
        {% if paginate.pages > 1 %}
          <nav style="display:flex;justify-content:center;gap:10px;margin-top:30px">
            {% if paginate.previous %}<a class="gk-btn gk-btn--secondary" href="{{ paginate.previous.url }}">Zurück</a>{% endif %}
            {% if paginate.next %}<a class="gk-btn gk-btn--secondary" href="{{ paginate.next.url }}">Weiter</a>{% endif %}
          </nav>
        {% endif %}
      {% else %}
        <div class="gk-empty-state"><h2>Noch keine Beiträge.</h2><p class="gk-copy">Sobald Wissensthemen veröffentlicht werden, erscheinen sie hier automatisch.</p></div>
      {% endif %}
    {% endpaginate %}
  </div>
</section>

{% schema %}
{"name":"GRUNDKRAFT Wissen","tag":"section","class":"section-main-blog","settings":[]}
{% endschema %}
