<section class="gk-password">
  <div class="gk-password__panel">
    <a href="{{ routes.root_url }}" class="gk-password__logo" aria-label="{{ shop.name }}">
      <img src="{{ 'gk-logo.svg' | asset_url }}" width="220" height="40" alt="GRUNDKRAFT">
    </a>
    <p class="gk-eyebrow">Gemacht für Macher.</p>
    <h1>{{ section.settings.heading }}</h1>
    <div class="gk-copy">{{ section.settings.text }}</div>

    {% form 'storefront_password', class: 'gk-password-form' %}
      {% if form.errors %}<div class="gk-form-error" role="alert">{{ form.errors | default_errors }}</div>{% endif %}
      <label class="gk-field-label" for="Password">Shop-Passwort</label>
      <div class="gk-password-form__row">
        <input id="Password" class="gk-input" type="password" name="password" autocomplete="current-password" required>
        <button class="gk-btn gk-btn--primary" type="submit">Öffnen</button>
      </div>
    {% endform %}

    <div class="gk-password__meta">{{ section.settings.note }}</div>
  </div>
  <div class="gk-password__visual" aria-hidden="true">
    <img src="{{ 'product-tub-tagwerk.svg' | asset_url }}" width="300" height="420" alt="">
    <div class="gk-password__g">G</div>
  </div>
</section>

{% schema %}
{
  "name": "GRUNDKRAFT Passwortseite",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Die Werkstatt ist noch nicht offen." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>GRUNDKRAFT wird gerade vorbereitet. Mit Shop-Passwort kannst du schon hinein.</p>" },
    { "type": "text", "id": "note", "label": "Hinweis", "default": "GRUNDKRAFT · Funktionale Versorgung für echte Arbeitstage." }
  ]
}
{% endschema %}
