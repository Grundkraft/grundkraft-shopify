<section id="inhaltsstoffe" class="gk-section gk-ingredients-section">
  <div class="gk-container">
    <header class="gk-split-head">
      <div>
        {% if section.settings.eyebrow != blank %}<p class="gk-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
        <h2 class="gk-heading gk-heading--lg">{{ section.settings.heading | escape }}</h2>
      </div>
      {% if section.settings.text != blank %}<div class="gk-copy">{{ section.settings.text }}</div>{% endif %}
    </header>

    <div class="gk-ingredient-grid">
      {% for block in section.blocks %}
        <article class="gk-ingredient-card" {{ block.shopify_attributes }}>
          <div class="gk-ingredient-card__index">0{{ forloop.index }}</div>
          <div class="gk-ingredient-card__line" aria-hidden="true"></div>
          <h3>{{ block.settings.heading | escape }}</h3>
          <p>{{ block.settings.text | escape }}</p>
          {% if block.settings.note != blank %}<span>{{ block.settings.note | escape }}</span>{% endif %}
        </article>
      {% endfor %}
    </div>

    <div class="gk-transparency-strip">
      <strong>{{ section.settings.strip_heading | escape }}</strong>
      <span>{{ section.settings.strip_text | escape }}</span>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Inhaltsstoffe & Transparenz",
  "tag": "section",
  "class": "section-gk-ingredients",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Kleine Überschrift", "default": "Klare Funktion" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Was drin ist, soll einen Zweck haben." },
    { "type": "richtext", "id": "text", "label": "Einleitung", "default": "<p>GRUNDKRAFT setzt auf nachvollziehbare Produktkonzepte statt Zutatenlisten als Dekoration. Die finalen Rezepturen werden vor Verkaufsstart verbindlich festgelegt und transparent ausgewiesen.</p>" },
    { "type": "text", "id": "strip_heading", "label": "Hinweis Überschrift", "default": "Keine Nebelmaschine." },
    { "type": "text", "id": "strip_text", "label": "Hinweis Text", "default": "Mengen, Anwendung und Kennzeichnung werden bei jedem fertigen Produkt klar dargestellt." }
  ],
  "blocks": [
    {
      "type": "ingredient_world",
      "name": "Funktionsbereich",
      "settings": [
        { "type": "text", "id": "heading", "label": "Überschrift", "default": "Flüssigkeit & Elektrolyte" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Für Produkte, die rund um lange, warme oder körperlich fordernde Tage gedacht sind." },
        { "type": "text", "id": "note", "label": "Kleine Zeile", "default": "Produktabhängig" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Inhaltsstoffe & Transparenz",
      "blocks": [
        { "type": "ingredient_world", "settings": { "heading": "Flüssigkeit & Elektrolyte", "text": "Für Produkte, die rund um lange, warme oder körperlich fordernde Tage gedacht sind.", "note": "Produktabhängig" } },
        { "type": "ingredient_world", "settings": { "heading": "Energie", "text": "Wo Energie eine Funktion erfüllt, behandeln wir sie nicht automatisch wie einen Fehler.", "note": "Je nach Produktkonzept" } },
        { "type": "ingredient_world", "settings": { "heading": "Kraft & Reserve", "text": "Gezielte Ergänzungen bekommen einen klaren Platz statt eines überladenen Alles-in-einem-Prinzips.", "note": "Zum Beispiel KRAFTRESERVE" } },
        { "type": "ingredient_world", "settings": { "heading": "Basisversorgung", "text": "Produkte für die tägliche Routine werden getrennt von akuten Arbeitstag-Lösungen gedacht.", "note": "In Entwicklung" } }
      ]
    }
  ]
}
{% endschema %}
