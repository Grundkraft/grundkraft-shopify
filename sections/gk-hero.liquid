<section class="gk-hero gk-grain">
  <div class="gk-hero__media">
    {% if section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 2400 | image_tag: widths: '750,1100,1500,2000,2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: section.settings.image_alt }}
    {% endif %}
  </div>
  <div class="gk-hero__overlay"></div>

  <div class="gk-container gk-hero__content">
    {% if section.settings.eyebrow != blank %}
      <p class="gk-eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}
    <h1 class="gk-heading gk-heading--xl">{{ section.settings.heading }}</h1>
    {% if section.settings.claim != blank %}
      <div class="gk-hero__claim">{{ section.settings.claim }}</div>
    {% endif %}
    {% if section.settings.text != blank %}
      <div class="gk-copy" style="margin:22px 0 28px">{{ section.settings.text }}</div>
    {% endif %}

    <div class="gk-btn-row">
      {% if section.settings.primary_label != blank %}
        <a class="gk-btn gk-btn--primary" href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}">{{ section.settings.primary_label }}</a>
      {% endif %}
      {% if section.settings.secondary_label != blank %}
        <a class="gk-btn gk-btn--secondary" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label }}</a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "GRUNDKRAFT Hero",
  "tag": "section",
  "class": "section-gk-hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Hero image" },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Menschen in körperlich fordernden Berufen" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Für echte Arbeitstage" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Gemacht für Macher." },
    { "type": "text", "id": "claim", "label": "Accent line", "default": "GRUNDKRAFT für deinen Alltag" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Funktionale Versorgung für Menschen, die jeden Tag körperlich leisten.</p>" },
    { "type": "text", "id": "primary_label", "label": "Primary button", "default": "Produkte entdecken" },
    { "type": "url", "id": "primary_link", "label": "Primary link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button", "default": "Unsere Idee" },
    { "type": "url", "id": "secondary_link", "label": "Secondary link" }
  ],
  "presets": [
    { "name": "GRUNDKRAFT Hero" }
  ]
}
{% endschema %}
