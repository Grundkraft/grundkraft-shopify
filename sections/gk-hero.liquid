<section class="gk-hero gk-grain">
  <div class="gk-hero__backdrop" aria-hidden="true"></div>

  <div class="gk-container gk-hero__grid">
    <div class="gk-hero__content">
      {% if section.settings.eyebrow != blank %}
        <p class="gk-eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}

      <h1 class="gk-heading gk-heading--xl">{{ section.settings.heading }}</h1>

      {% if section.settings.claim != blank %}
        <div class="gk-hero__claim">{{ section.settings.claim }}</div>
      {% endif %}

      {% if section.settings.text != blank %}
        <div class="gk-copy gk-hero__copy">{{ section.settings.text }}</div>
      {% endif %}

      <div class="gk-btn-row">
        {% if section.settings.primary_label != blank %}
          <a class="gk-btn gk-btn--primary" href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}">{{ section.settings.primary_label }}</a>
        {% endif %}
        {% if section.settings.secondary_label != blank %}
          <a class="gk-btn gk-btn--secondary" href="{{ section.settings.secondary_link | default: routes.all_products_collection_url }}">{{ section.settings.secondary_label }}</a>
        {% endif %}
      </div>

      <div class="gk-hero__micro" aria-label="GRUNDKRAFT Prinzipien">
        <span>Alltag statt Hype</span>
        <span>Klare Routinen</span>
        <span>Gemacht für Macher</span>
      </div>
    </div>

    <div class="gk-hero__visual">
      <div class="gk-hero__frame">
        <div class="gk-hero__media">
          {% if section.settings.image != blank %}
            {{ section.settings.image | image_url: width: 1600 | image_tag: widths: '600,900,1200,1600', sizes: '(min-width: 901px) 48vw, 100vw', loading: 'eager', fetchpriority: 'high', alt: section.settings.image_alt }}
          {% else %}
            <img src="{{ 'gk-hero-people-metal.jpg' | asset_url }}" width="272" height="337" loading="eager" fetchpriority="high" alt="Menschen aus unterschiedlichen Lebensbereichen vor metallischem GRUNDKRAFT G">
          {% endif %}
        </div>
        <div class="gk-hero__frame-lines" aria-hidden="true"></div>
      </div>

      {% if section.settings.show_product %}
        <img class="gk-hero__product" src="{{ 'product-tub-tagwerk.svg' | asset_url }}" width="300" height="420" loading="eager" alt="TAGWERK Produktbehälter">
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "GRUNDKRAFT Hero",
  "tag": "section",
  "class": "section-gk-hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Hero-Bild rechts (optional, Standard = Mockup-Asset)" },
    { "type": "text", "id": "image_alt", "label": "Bildbeschreibung", "default": "Menschen mitten im echten Alltag" },
    { "type": "checkbox", "id": "show_product", "label": "TAGWERK Behälter zeigen", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Kleine Überschrift", "default": "Für echte Arbeitstage" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Gemacht für Macher." },
    { "type": "text", "id": "claim", "label": "Akzentzeile", "default": "Für alle, die im Leben anpacken." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Funktionale Versorgung für Menschen, die jeden Tag körperlich leisten. Entwickelt aus dem echten Arbeitsalltag.</p>" },
    { "type": "text", "id": "primary_label", "label": "Primärer Button", "default": "TAGWERK entdecken" },
    { "type": "url", "id": "primary_link", "label": "Primärer Link" },
    { "type": "text", "id": "secondary_label", "label": "Sekundärer Button", "default": "Zum Sortiment" },
    { "type": "url", "id": "secondary_link", "label": "Sekundärer Link" }
  ],
  "presets": [
    { "name": "GRUNDKRAFT Hero" }
  ]
}
{% endschema %}
