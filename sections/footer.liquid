<footer class="gk-footer">
  <div class="gk-container">
    <div class="gk-footer__topline" aria-hidden="true"><span>GRUNDKRAFT</span><span>GEMACHT FÜR MACHER.</span></div>

    <div class="gk-footer__grid">
      <div class="gk-footer__brand">
        <a class="gk-logo" href="{{ routes.root_url }}" aria-label="GRUNDKRAFT Startseite">
          <img class="gk-logo__fallback" src="{{ 'gk-logo.svg' | asset_url }}" width="184" height="33" loading="lazy" alt="GRUNDKRAFT">
        </a>
        <p class="gk-copy">{{ section.settings.intro }}</p>
        <div class="gk-footer__mark" aria-hidden="true">G</div>
      </div>

      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          <div class="gk-footer__column" {{ block.shopify_attributes }}>
            <p class="gk-footer__heading">{{ block.settings.heading }}</p>
            {% if block.settings.menu != blank %}
              <div class="gk-footer__links">
                {% for link in block.settings.menu.links %}
                  <a href="{{ link.url }}">{{ link.title }}</a>
                {% endfor %}
              </div>
            {% endif %}
          </div>
        {% endfor %}
      {% else %}
        <div class="gk-footer__column">
          <p class="gk-footer__heading">Entdecken</p>
          <div class="gk-footer__links">
            <a href="#anwendungsbereiche">Anwendungsbereiche</a>
            <a href="#produkte">Produkte</a>
            <a href="#inhaltsstoffe">Inhaltsstoffe</a>
            <a href="#faq">FAQ</a>
          </div>
        </div>
        <div class="gk-footer__column">
          <p class="gk-footer__heading">GRUNDKRAFT</p>
          <div class="gk-footer__links">
            <a href="#unsere-idee">Unsere Idee</a>
            <a href="#fuer-betriebe">Für Betriebe</a>
            <a href="#die-macher">Die Macher</a>
          </div>
        </div>
        <div class="gk-footer__column">
          <p class="gk-footer__heading">Rechtliches</p>
          <div class="gk-footer__links">
            {% if shop.privacy_policy.body != blank %}<a href="{{ shop.privacy_policy.url }}">Datenschutz</a>{% endif %}
            {% if shop.terms_of_service.body != blank %}<a href="{{ shop.terms_of_service.url }}">AGB</a>{% endif %}
            {% if shop.shipping_policy.body != blank %}<a href="{{ shop.shipping_policy.url }}">Versand</a>{% endif %}
            {% if shop.refund_policy.body != blank %}<a href="{{ shop.refund_policy.url }}">Widerruf & Rückgabe</a>{% endif %}
          </div>
        </div>
      {% endif %}
    </div>

    <div class="gk-footer__bottom">
      <span>© {{ 'now' | date: '%Y' }} GRUNDKRAFT.</span>
      <span>Gemacht für Macher.</span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "max_blocks": 3,
  "settings": [
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "Funktionale Versorgung für Menschen, die jeden Tag körperlich leisten."
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menüspalte",
      "settings": [
        { "type": "text", "id": "heading", "label": "Überschrift", "default": "GRUNDKRAFT" },
        { "type": "link_list", "id": "menu", "label": "Menü" }
      ]
    }
  ]
}
{% endschema %}
