<section id="anwendungsbereiche" class="gk-section gk-pillars-section">
  <div class="gk-container">
    <header class="gk-pillars-section__head">
      <p class="gk-eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="gk-heading gk-heading--lg">{{ section.settings.heading }}</h2>
      <div class="gk-copy">{{ section.settings.text }}</div>
    </header>

    <div class="gk-pillars">
      {% for block in section.blocks %}
        <article class="gk-panel gk-pillar gk-halftone" {{ block.shopify_attributes }}>
          <div class="gk-pillar__number">{{ forloop.index }}</div>
          <div class="gk-pillar__icon" aria-hidden="true">
            {% case forloop.index %}
              {% when 1 %}
                <svg viewBox="0 0 48 48" role="presentation"><path d="M13 21v-3c0-7 5-12 11-12s11 5 11 12v3M9 22h30M15 22v6c0 6 4 11 9 11s9-5 9-11v-6M18 10v8M30 10v8"/></svg>
              {% when 2 %}
                <svg viewBox="0 0 48 48" role="presentation"><circle cx="17" cy="16" r="6"/><circle cx="31" cy="16" r="6"/><circle cx="24" cy="29" r="6"/><path d="M7 39c1-7 5-11 10-11M41 39c-1-7-5-11-10-11M14 43c1-7 4-11 10-11s9 4 10 11"/></svg>
              {% else %}
                <svg viewBox="0 0 48 48" role="presentation"><path d="M24 42V19M24 24c-7-1-11-5-12-12 7 1 11 5 12 12ZM24 31c7-1 11-5 12-12-7 1-11 5-12 12ZM11 42h26M18 9h12"/></svg>
            {% endcase %}
          </div>
          <h3>{{ block.settings.heading }}</h3>
          <p>{{ block.settings.text }}</p>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "3 Säulen des Alltags",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Das System" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Die 3 Säulen des Alltags" },
    { "type": "richtext", "id": "text", "label": "Intro", "default": "<p>GRUNDKRAFT denkt Versorgung entlang eines echten Alltags: Job, Alltag und das Leben danach.</p>" }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Säule",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "ECHTER JOB" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Bau, Pflege, Produktion" }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "3 Säulen des Alltags",
      "blocks": [
        { "type": "pillar", "settings": { "heading": "ECHTER JOB", "text": "Bau, Pflege, Produktion" } },
        { "type": "pillar", "settings": { "heading": "ECHTER ALLTAG", "text": "Haushalt, Kinder, Stress" } },
        { "type": "pillar", "settings": { "heading": "ECHTES LEBEN", "text": "Garten, Bewegung, Alter" } }
      ]
    }
  ]
}
{% endschema %}
