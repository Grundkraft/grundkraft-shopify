<header class="gk-header" data-gk-header>
  <div class="gk-container gk-header__inner">
    <a class="gk-logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
      {% if settings.logo != blank %}
        {{ settings.logo | image_url: width: settings.logo_width | image_tag: widths: '120,180,240,320', width: settings.logo_width, loading: 'eager', alt: shop.name }}
      {% else %}
        <img class="gk-logo__fallback" src="{{ 'gk-logo.svg' | asset_url }}" width="184" height="33" loading="eager" alt="GRUNDKRAFT">
      {% endif %}
    </a>

    <nav class="gk-nav" aria-label="Hauptnavigation">
      {% if section.settings.use_shopify_menu and section.settings.menu != blank %}
        {% for link in section.settings.menu.links %}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {% endfor %}
      {% else %}
        <a href="{{ routes.root_url }}#anwendungsbereiche">Anwendungsbereiche</a>
        <a href="{{ routes.all_products_collection_url }}">Produkte</a>
        <a href="{{ routes.root_url }}#inhaltsstoffe">Inhaltsstoffe</a>
        <a href="{{ routes.root_url }}#faq">FAQ</a>
      {% endif %}
    </nav>

    <div class="gk-header__actions">
      <a class="gk-btn gk-btn--primary gk-header__cta" href="{{ routes.all_products_collection_url }}">TAGWERK sichern</a>
      <a class="gk-icon-btn" href="{{ routes.search_url }}" aria-label="Suche">
        <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="m16 16 4 4" fill="none" stroke="currentColor" stroke-width="1.7"/></svg>
      </a>
      <a class="gk-icon-btn" href="{{ routes.cart_url }}" aria-label="Warenkorb mit {{ cart.item_count }} Artikeln">
        <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><path d="M4 5h2l1.5 9h9.5l2-6H7" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/><circle cx="10" cy="18" r="1.3"/><circle cx="17" cy="18" r="1.3"/></svg>
        <span style="font-size:.68rem;font-weight:900">{{ cart.item_count }}</span>
      </a>
      <button class="gk-icon-btn gk-mobile-toggle" type="button" data-mobile-toggle aria-expanded="false" aria-controls="GkMobileMenu" aria-label="{{ 'header.menu' | t }}">☰</button>
    </div>
  </div>

  <div id="GkMobileMenu" data-mobile-menu hidden>
    <div class="gk-container" style="padding:18px 0 24px;display:grid;gap:14px;border-top:1px solid var(--gk-border)">
      {% if section.settings.use_shopify_menu and section.settings.menu != blank %}
        {% for link in section.settings.menu.links %}
          <a href="{{ link.url }}" style="font-weight:800;text-transform:uppercase">{{ link.title }}</a>
        {% endfor %}
      {% else %}
        <a href="{{ routes.root_url }}#anwendungsbereiche">Anwendungsbereiche</a>
        <a href="{{ routes.all_products_collection_url }}">Produkte</a>
        <a href="{{ routes.root_url }}#inhaltsstoffe">Inhaltsstoffe</a>
        <a href="{{ routes.root_url }}#faq">FAQ</a>
        <a href="{{ routes.search_url }}">Suche</a>
      {% endif %}
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "checkbox",
      "id": "use_shopify_menu",
      "label": "Shopify-Menü statt GRUNDKRAFT Master-Navigation verwenden",
      "default": false
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Shopify-Menü",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
