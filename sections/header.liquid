{% liquid
  assign tagwerk_product = all_products['tagwerk']
  if tagwerk_product == blank
    for candidate in collections.all.products
      assign candidate_title = candidate.title | downcase
      if candidate_title contains 'tagwerk'
        assign tagwerk_product = candidate
        break
      endif
    endfor
  endif
  assign tagwerk_url = routes.all_products_collection_url
  if tagwerk_product != blank
    assign tagwerk_url = tagwerk_product.url
  endif
%}

<header class="gk-header" data-gk-header>
  <div class="gk-container gk-header__inner">
    <a class="gk-logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
      {% render 'gk-logo', loading: 'eager' %}
    </a>

    <nav class="gk-nav" aria-label="Hauptnavigation">
      {% if section.settings.use_shopify_menu and section.settings.menu != blank %}
        {% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}
      {% else %}
        <a href="{{ routes.root_url }}#anwendungsbereiche">Anwendungsbereiche</a>
        <a href="{{ routes.all_products_collection_url }}">Produkte</a>
        <a href="{{ routes.root_url }}#inhaltsstoffe">Inhaltsstoffe</a>
        <a href="{{ routes.root_url }}#faq">FAQ</a>
      {% endif %}
    </nav>

    <div class="gk-header__actions">
      <a class="gk-btn gk-btn--primary gk-header__cta" href="{{ tagwerk_url }}">TAGWERK sichern</a>
      <a class="gk-icon-btn" href="{{ routes.search_url }}" aria-label="Suche"><svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="m16 16 4 4" fill="none" stroke="currentColor" stroke-width="1.7"/></svg></a>
      {% if shop.customer_accounts_enabled %}
        <a class="gk-icon-btn" href="{{ routes.account_url }}" aria-label="Kundenkonto"><svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><circle cx="12" cy="8" r="3.5" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="M5.5 20c.7-4.2 3-6.3 6.5-6.3s5.8 2.1 6.5 6.3" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg></a>
      {% endif %}
      <a class="gk-icon-btn gk-cart-link" href="{{ routes.cart_url }}" aria-label="Warenkorb mit {{ cart.item_count }} Artikeln"><svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><path d="M4 5h2l1.5 9h9.5l2-6H7" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/><circle cx="10" cy="18" r="1.3"/><circle cx="17" cy="18" r="1.3"/></svg><span class="gk-cart-count" data-gk-cart-count>{{ cart.item_count }}</span></a>
      <button class="gk-icon-btn gk-mobile-toggle" type="button" data-mobile-toggle aria-expanded="false" aria-controls="GkMobileMenu" aria-label="{{ 'header.menu' | t }}">☰</button>
    </div>
  </div>

  <div id="GkMobileMenu" data-mobile-menu hidden>
    <div class="gk-container gk-mobile-menu__inner">
      {% if section.settings.use_shopify_menu and section.settings.menu != blank %}
        {% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}
      {% else %}
        <a href="{{ routes.root_url }}#anwendungsbereiche">Anwendungsbereiche</a>
        <a href="{{ routes.all_products_collection_url }}">Produkte</a>
        <a href="{{ routes.root_url }}#inhaltsstoffe">Inhaltsstoffe</a>
        <a href="{{ routes.root_url }}#faq">FAQ</a>
        <a href="{{ routes.search_url }}">Suche</a>
        {% if shop.customer_accounts_enabled %}<a href="{{ routes.account_url }}">Kundenkonto</a>{% endif %}
      {% endif %}
      <a class="gk-btn gk-btn--primary" href="{{ tagwerk_url }}">TAGWERK sichern</a>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "checkbox", "id": "use_shopify_menu", "label": "Shopify-Menü statt GRUNDKRAFT Master-Navigation verwenden", "default": false },
    { "type": "link_list", "id": "menu", "label": "Shopify-Menü", "default": "main-menu" }
  ]
}
{% endschema %}
